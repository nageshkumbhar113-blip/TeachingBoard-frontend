{
  "name": "teachingboard-split-apps",
  "version": "7.4.16",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node server.js",
    "postinstall": "npm install --prefix TeachingBoard-backend",
    "serve": "node tools/static-server.mjs",
    "test:runtime": "playwright test",
    "mobile:prepare": "node tools/prepare-mobile.mjs",
    "cap:sync": "npm run mobile:prepare && cap sync",
    "cap:add:android": "npm run mobile:prepare && cap add android",
    "student:prepare": "node tools/prepare-student.mjs",
    "student:build": "build-student.bat",
    "admin:prepare": "node tools/prepare-admin.mjs",
    "admin:build": "build-admin.bat"
  },
  "devDependencies": {
    "@capacitor/android": "^7.4.2",
    "@capacitor/cli": "^7.4.2",
    "@capacitor/core": "^7.4.2",
    "@playwright/test": "^1.55.0",
    "typescript": "^6.0.3"
  },
  "dependencies": {
    "@capacitor-community/text-to-speech": "^8.0.2",
    "@capacitor/browser": "^7.0.5",
    "@capacitor/filesystem": "^8.1.2",
    "@capacitor/push-notifications": "^8.1.1",
    "@capacitor/share": "^8.0.1"
  }
}
