{
  "installCommand": "echo no-install-needed",
  "buildCommand": "node site-build/build.mjs",
  "outputDirectory": ".",
  "cleanUrls": false,
  "trailingSlash": false,
  "redirects": [
    { "source": "/:path*", "has": [{ "type": "host", "value": "www.nkseduorbit.in" }], "destination": "https://nkseduorbit.in/:path*", "permanent": true },
    { "source": "/student",  "destination": "/student-app/index.html",   "permanent": false },
    { "source": "/admin",    "destination": "/admin-app/admin.html",     "permanent": false },
    { "source": "/get-app",  "destination": "/get-app.html",             "permanent": false },
    { "source": "/shop",     "destination": "/shop.html",                "permanent": false },
    { "source": "/teachers", "destination": "/teacher-portal/index.html","permanent": false },
    { "source": "/team",     "destination": "/team-app/index.html",      "permanent": false }
  ],
  "rewrites": [
    { "source": "/exams",        "destination": "/exams/index.html" },
    { "source": "/exams/:slug",  "destination": "/exams/:slug/index.html" },
    { "source": "/student/:path*",  "destination": "/student-app/index.html" },
    { "source": "/admin/:path*",    "destination": "/admin-app/admin.html" },
    { "source": "/teachers/:path*", "destination": "/teacher-portal/index.html" },
    { "source": "/favicon.ico",     "destination": "/icons/icon-72.png" }
  ],
  "headers": [
    {
      "source": "/sw.js",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }
      ]
    }
  ]
}
