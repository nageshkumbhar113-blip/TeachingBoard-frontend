<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Android TV: declare leanback support as optional and don't require a
         touchscreen, so this same APK can install/launch on Android TV devices
         in addition to phones/tablets (Phase A — packaging only). -->
    <uses-feature android:name="android.software.leanback" android:required="false" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme"
        android:networkSecurityConfig="@xml/network_security_config"
        android:banner="@drawable/tv_banner">

        <!-- Devices without Google Play Services (many smart boards / IFPDs)
             crash on cold start — confirmed still crashing pre-splash even
             after the auto-init meta-data flags below, so this goes further:
             FirebaseInitProvider itself (a ContentProvider Android instantiates
             for every app process, before Application.onCreate, let alone any
             Activity or JS) is removed from the merged manifest entirely.
             Nothing Firebase-related now runs at process start on ANY device.
             MainActivity.java calls FirebaseApp.initializeApp() itself instead
             — early in onCreate, try/catch-guarded, and touches no Play
             Services API (that part of Firebase doesn't need it) — which is
             enough for student-app/app.js's later Push.register() call
             (already try/catch-guarded there too) to keep working on real
             phones. Keeping these two flags anyway as defense in depth. -->
        <meta-data
            android:name="firebase_messaging_auto_init_enabled"
            android:value="false" />
        <meta-data
            android:name="firebase_analytics_collection_enabled"
            android:value="false" />
        <provider
            android:name="com.google.firebase.provider.FirebaseInitProvider"
            android:authorities="${applicationId}.firebaseinitprovider"
            tools:node="remove" />

        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>

        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>
    </application>

    <!-- Package visibility (Android 11+): without this, the app can't see
         installed UPI apps (GPay, PhonePe, Paytm...), so Razorpay's checkout
         silently hides the UPI option even when it's enabled on the account. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <category android:name="android.intent.category.BROWSABLE" />
            <data android:scheme="upi" />
        </intent>
    </queries>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />
</manifest>
